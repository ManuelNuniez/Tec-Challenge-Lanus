# Conexión a PostgreSQL (Neon). En Vercel las crea la integración de Storage.
# Pooled: la usa la app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Directa: la usa Prisma para migrar.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Clave para firmar la cookie de sesión (cualquier texto largo y aleatorio).
SESSION_SECRET="generá-una-clave-larga-y-aleatoria"
